{
  "compilerOptions": {
    "target": "ES2023",
    "module": "ESNext",
    "moduleResolution": "bundler",
    "lib": ["ES2023", "DOM", "DOM.Iterable"],
    "types": ["vite/client"],
    "strict": true,
    "noUncheckedIndexedAccess": true,
    "exactOptionalPropertyTypes": true,
    "noImplicitOverride": true,
    "verbatimModuleSyntax": true,
    "noEmit": true,
    "skipLibCheck": true
  },
  "include": ["src/ui/**/*.ts", "src/engine/api/protocollo.ts", "src/engine/api/telaio-video.ts"],
  // `vite.config.ts` gira in Node e i test girano nel test runner di Node: qui
  // dentro non hanno i tipi giusti, e aggiungerli farebbe entrare
  // `NodeJS.Timeout` in tutto il resto dell'interfaccia. I test hanno il loro
  // progetto in `tsconfig.ui-test.json`.
  "exclude": ["src/ui/vite.config.ts", "src/ui/**/*.test.ts"]
}
